{
  "name": "ai-mock-interview-backend",
  "version": "1.0.0",
  "description": "Backend engine for AI Mock Interview Platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node scripts/seed.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/services/ai/*.js",
      "src/utils/*.js",
      "src/middleware/*.js",
      "src/modules/auth/auth.controller.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true,
    "setupFiles": [
      "<rootDir>/src/tests/setup.js"
    ]
  },
  "dependencies": {
    "@deepgram/sdk": "^3.13.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "_removed": {
    "vm2": "REMOVED — abandoned package with known RCE vulnerabilities (CVE-2023-29017). Replaced with Piston API."
  }
}
